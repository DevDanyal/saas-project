# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/inbox_assistant

# Security
ENCRYPTION_KEY=your-32-byte-encryption-key-here
SESSION_SECRET=your-session-secret-here

# Google OAuth (Gmail)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/redirect

# AI Providers (at least one required)
OPENAI_API_KEY=your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
GEMINI_API_KEY=your-gemini-key

# Frontend / backend origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Background jobs (sync inbox, auto-process, daily digest)
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=15
DIGEST_HOUR_UTC=11
SCHEDULER_TICK_SECONDS=60
AUTO_PROCESS_LIMIT=25
AUTO_PROCESS_MAX_RESULTS=20

# Bounce webhook shared secret (optional)
BOUNCE_WEBHOOK_SECRET=

# Stripe Billing
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_PRO=price_pro
STRIPE_PRICE_TEAM=price_team