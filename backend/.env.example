# Copy to .env and fill in. Never commit .env.

# Database (Phase 1) — e.g. Neon/Supabase Postgres URL
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Encryption key for email content + tokens at rest (Phase 2)
ENCRYPTION_KEY=change-me-generate-via-openssl-rand-base64-32

# Gmail API OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/redirect

# AI (Phase 3) — at least one provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Session/auth secret
SESSION_SECRET=change-me

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000