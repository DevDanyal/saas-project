# Copy to .env and fill in. Never commit .env.

# Database (Phase 1) — e.g. Neon/Supabase Postgres URL
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Encryption key for email content + tokens at rest (Phase 2)
ENCRYPTION_KEY=change-me-generate-via-openssl-rand-base64-32

# Gmail API OAuth (Phase 2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/redirect

# AI (Phase 3) — at least one provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Session/auth secret
SESSION_SECRET=change-me

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:3000

# Backend origin (used in unsubscribe links/headers)
BACKEND_URL=http://localhost:8000

# Bounce webhook shared secret (optional; required header X-Webhook-Secret once set)
BOUNCE_WEBHOOK_SECRET=

# Stripe (Phase 5)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Background jobs (Phase 3+) — sync inbox, auto-process email, build daily digest
SCHEDULER_ENABLED=false
SYNC_INTERVAL_MINUTES=15
DIGEST_HOUR_UTC=11
SCHEDULER_TICK_SECONDS=60
AUTO_PROCESS_LIMIT=25
AUTO_PROCESS_MAX_RESULTS=20